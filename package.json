{
  "name": "land",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv --no-compile-autoload-tsconfig --no-compile-autoload-package-json --outfile dist/land",
    "check": "tsc --noEmit && prettier --check . && bun test --timeout 60000"
  },
  "dependencies": {
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  }
}
